# ==============================================================================
# OPENROUTER API CONFIGURATION
# Endpoint: https://openrouter.ai/api/v1/chat/completions
# Model:    meta-llama/llama-3.3-70b-instruct
# ==============================================================================

# Replace <OPENROUTER_API_KEY> with your actual OpenRouter key
OPENROUTER_API_KEY=<OPENROUTER_API_KEY>
ROUTER_API_KEY=<OPENROUTER_API_KEY>

# OpenRouter Base URL & Chat Completions Endpoint
ROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_URL=https://openrouter.ai/api/v1/chat/completions

# Primary LLM used for RAG generation & RAGAS evaluation judge
ROUTER_LLM_MODEL=meta-llama/llama-3.3-70b-instruct
ROUTER_JUDGE_MODEL=meta-llama/llama-3.3-70b-instruct

# Optional OpenRouter Ranking Headers
ROUTER_HTTP_REFERER=http://localhost:8501
ROUTER_X_OPENROUTER_TITLE=Production-RAG-Evaluation-Framework

# Embedding settings (keep false for OpenRouter chat-only routing; uses local dense embeddings)
USE_ROUTER_EMBEDDINGS=false
ROUTER_EMBEDDING_MODEL=text-embedding-3-small

# Evaluation Settings
TOP_K_RETRIEVAL=3
EVALUATION_MODE=auto
